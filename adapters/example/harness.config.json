{
  "tasksDir": "docs/tasks",
  "groupPrefix": "sprint-",
  "groupField": "sprintNumber",
  "stages": [
    "bootstrap",
    "fsd_write",
    "fsd_review",
    "technical_plan",
    "implementation",
    "adversarial_review",
    "reviewing"
  ],
  "gate4Statuses": [
    "reviewing",
    "mr_created",
    "done"
  ],
  "models": {
    "cheap": "haiku",
    "mid": "sonnet",
    "strong": "opus"
  },
  "repos": [
    {
      "name": "<repo-name>",
      "path": ".",
      "layer": "frontend"
    }
  ],
  "layers": [
    "frontend"
  ],
  "roles": [
    "orchestrator",
    "fsd-writer",
    "fsd-reviewer",
    "technical-planner",
    "fe-implementer",
    "fe-fix",
    "adversary"
  ],
  "routing": {
    "field": "branchType",
    "map": {
      "feature": "fe-implementer",
      "hotfix": "fe-implementer",
      "bugfix": "fe-fix"
    }
  },
  "lineCaps": {
    "00-Metadata.md": 80,
    "01-FSD.md": 250,
    "02-FSD-Review.md": 150,
    "03-Technical-Plan.md": 200,
    "06-FE-Implementation-Notes.md": 250
  },
  "handoffBlockCap": 30,
  "requiredAtStage": [
    {
      "stage": "bootstrap",
      "files": [
        "task.agent.json",
        "00-Metadata.md"
      ]
    },
    {
      "stage": "fsd_review",
      "files": [
        "01-FSD.md"
      ]
    },
    {
      "stage": "technical_plan",
      "files": [
        "02-FSD-Review.md"
      ]
    },
    {
      "stage": "implementation",
      "files": [
        "03-Technical-Plan.md"
      ]
    },
    {
      "stage": "adversarial_review",
      "files": [
        "06-FE-Implementation-Notes.md",
        "08-Test-Evidence.md"
      ]
    }
  ],
  "gate4Artifacts": {
    "evidence": "08-Test-Evidence.md",
    "notes": "06-FE-Implementation-Notes.md",
    "adversarial": "09-Adversarial-Review.md"
  },
  "acTrace": {
    "declaredIn": "02-FSD-Review.md",
    "reachedIn": [
      {
        "doc": "03-Technical-Plan.md",
        "fromStage": "implementation"
      },
      {
        "doc": "08-Test-Evidence.md",
        "fromStage": "adversarial_review"
      }
    ],
    "since": "2026-07-28"
  },
  "evidenceCommandPattern": "npm run (test:scope|test:run|test:all|test:e2e:run|test:coverage|lint|build)|npx (vitest run|tsc -b|tsc --noEmit|eslint)",
  "evidenceSampleCommand": "npm run test:scope -- src/test/x",
  "tracker": {
    "urlPattern": "^https://app\\.clickup\\.com/t/.+"
  },
  "retryBudget": 4,
  "roleStage": {
    "orchestrator": "bootstrap",
    "fsd-writer": "fsd_write",
    "fsd-reviewer": "fsd_review",
    "technical-planner": "technical_plan",
    "fe-implementer": "implementation",
    "fe-fix": "implementation",
    "adversary": "adversarial_review"
  },
  "lineWarn": {
    "08-Test-Evidence.md": 400,
    "09-Adversarial-Review.md": 400
  }
}
