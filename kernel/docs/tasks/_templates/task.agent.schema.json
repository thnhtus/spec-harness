{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec-harness/kernel/task.agent.schema.json",
  "title": "task.agent.json — spec-harness task state",
  "description": "Machine-readable state for one ClickUp task. Normative field list: docs/agents/SharedRules.md §6.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "taskId",
    "taskName",
    "clickupUrl",
    "repoName",
    "sprintNumber",
    "developer",
    "branchType",
    "layer",
    "taskComplexity",
    "currentStage",
    "status",
    "branch",
    "docsPath",
    "agents",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "taskId": {
      "type": "string",
      "minLength": 1,
      "description": "ClickUp task id, e.g. 86d2x6jc0"
    },
    "taskName": { "type": "string", "minLength": 1 },
    "clickupUrl": {
      "type": "string",
      "$comment": "Tracker task URL. Field name is historical (ClickUp); the URL shape is injected from harness.config.json → tracker.urlPattern, so any tracker works without renaming existing task data."
    },
    "repoName": { "type": "string", "minLength": 1 },
    "sprintNumber": { "type": "integer", "minimum": 1 },
    "developer": { "type": "string", "minLength": 1 },
    "branchType": {
      "type": "string",
      "enum": ["feature", "hotfix", "bugfix"]
    },
    "layer": {
      "type": "string",
      "$comment": "Allowed values injected from harness.config.json → layers. A FE-only project declares [\"frontend\"]; a monorepo or BE project declares its own."
    },
    "taskComplexity": {
      "type": "string",
      "enum": ["trivial", "normal", "high"]
    },
    "currentStage": {
      "type": "string",
      "enum": [
        "bootstrap",
        "fsd_write",
        "fsd_review",
        "technical_plan",
        "implementation",
        "adversarial_review",
        "reviewing"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "DRAFT",
        "in_progress",
        "blocked",
        "needs_clarification",
        "reviewing",
        "mr_created",
        "done"
      ]
    },
    "branch": {
      "type": "string",
      "minLength": 1,
      "description": "Conventional branch name per ProjectRules §3 — same slug as docsPath. Deliberately not pattern-enforced: projects change their branch convention over time and older tasks must stay valid."
    },
    "branchActual": {
      "type": "string",
      "description": "Optional. Real working branch when it differs from the conventional `branch` (user-managed branch exception, SharedRules §3)."
    },
    "parentTaskId": {
      "type": "string",
      "description": "Optional. Parent ClickUp task id, empty string when none."
    },
    "subTaskKey": {
      "type": "string",
      "minLength": 1,
      "description": "Optional. Distinct slug disambiguating multiple folders that share one ClickUp taskId (separate sub-bugs of the same ClickUp item). Required to be distinct per folder when a taskId is reused."
    },
    "complexity": {
      "type": "object",
      "description": "Complexity vector (Agents.md §5.1). taskComplexity is DERIVED from it by formula §5.1.1 — the validator recomputes and rejects a mismatch.",
      "required": ["vector"],
      "properties": {
        "vector": {
          "type": "object",
          "required": ["scope", "uncertainty", "dependency", "dataImpact", "integration", "testing", "blastRadius", "reversibility"],
          "properties": {
            "scope": { "type": "integer", "minimum": 0, "maximum": 2 },
            "uncertainty": { "type": "integer", "minimum": 0, "maximum": 2 },
            "dependency": { "type": "integer", "minimum": 0, "maximum": 2 },
            "dataImpact": { "type": "integer", "minimum": 0, "maximum": 2 },
            "integration": { "type": "integer", "minimum": 0, "maximum": 2 },
            "testing": { "type": "integer", "minimum": 0, "maximum": 2 },
            "blastRadius": { "type": "integer", "minimum": 0, "maximum": 4 },
            "reversibility": { "type": "integer", "minimum": 0, "maximum": 4 }
          }
        },
        "effort": { "type": "integer", "minimum": 0, "maximum": 12 },
        "assessedAt": { "type": "string", "minLength": 1 },
        "note": { "type": "string" }
      }
    },
    "docsPath": {
      "type": "string",
      "$comment": "pattern injected from harness.config.json → tasksDir + groupPrefix"
    },
    "agents": {
      "type": "object",
      "description": "Per-role status. Six canonical FE roles required; extra roles allowed.",
      "additionalProperties": {
        "type": "object",
        "required": ["status"],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "in_progress",
              "done",
              "not_applicable",
              "blocked",
              "needs_clarification",
              "skipped"
            ]
          }
        }
      },
      "required": [
        "orchestrator",
        "fsd-writer",
        "fsd-reviewer",
        "technical-planner",
        "fe-implementer",
        "fe-fix",
        "adversary"
      ]
    },
    "attempts": {
      "type": "object",
      "description": "How many times each stage actually ran. Optimal is 1; >1 means a gate sent it back. This is the harness's Step Efficiency signal — rework is measured, not estimated.",
      "additionalProperties": { "type": "integer", "minimum": 1 }
    },
    "createdAt": { "type": "string", "minLength": 1 },
    "updatedAt": { "type": "string", "minLength": 1 }
  },
  "allOf": [
    {
      "$comment": "Branch type must match implementer: feature/hotfix => fe-implementer active; bugfix => fe-fix active.",
      "if": {
        "properties": { "branchType": { "const": "bugfix" } }
      },
      "then": {
        "properties": {
          "agents": {
            "properties": {
              "fe-implementer": {
                "properties": {
                  "status": { "const": "not_applicable" }
                }
              }
            }
          }
        }
      }
    }
  ]
}
